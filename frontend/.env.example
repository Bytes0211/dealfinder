# Base URL of the Deal Finder API (no trailing slash)
# Local dev: leave empty to use the Vite proxy (see vite.config.ts)
# Production: set to your API Gateway URL
VITE_API_BASE_URL=

# Cognito Hosted UI settings
# Domain: e.g. dealfinder-prod.auth.us-east-1.amazoncognito.com
VITE_COGNITO_DOMAIN=
VITE_COGNITO_CLIENT_ID=
# Defaults to window.location.origin + /auth/callback if not set
VITE_COGNITO_REDIRECT_URI=
